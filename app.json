{
  "expo": {
    "name": "YURI AI",
    "slug": "yuri-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "yuri",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#111318"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yuri.ai",
      "infoPlist": {
        "NSCameraUsageDescription": "YURI AI needs camera access for live virtual try-on",
        "NSPhotoLibraryUsageDescription": "YURI AI needs photo library access to upload clothing and photos",
        "NSLocationWhenInUseUsageDescription": "YURI AI uses location for weather-based outfit suggestions"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#111318"
      },
      "package": "com.yuri.ai",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow YURI AI to access your camera for live try-on"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow YURI AI to access your photos for wardrobe and try-on"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
